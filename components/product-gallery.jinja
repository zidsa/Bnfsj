{# Product gallery. IDs/classes are part of the bnfsj-product.js contract. #}
<div id="wrap" class="bnfsj-product-gallery">
  <div class="row">
    <div class="col-12 col-product-image-wrapper">
      <div class="box-1-1 product-images-carousel product-images-carousel-init{% if product.selected_product.images | length <= 0 %} d-none{% endif %}">
        <div class="content">
          <div id="product-images" class="product-images slide gallery">
            <div id="product-images-slick" data-bnfsj-gallery>
              {% for image in product.selected_product.images %}
                <div>
                  <div class="box-1-1">
                    <div class="content">
                      <div class="image-link bnfsj-product-gallery-link">
                        <img src="{{ image_url(image.image.full_size, w=1280, q=90, f='auto') }}" class="carousel-img" alt="{{ image.alt_text | default(product.name, true) }}">
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="row lg-thumbs d-lg-flex product-images-carousel-thumbs{% if product.selected_product.images | length <= 1 %} d-none-important{% endif %}">
        {% for image in product.selected_product.images %}
          <div class="col-3">
            <div class="box-1-1">
              <div class="content">
                <button type="button" class="d-flex align-items-center justify-content-center thumb-image-a bnfsj-product-gallery-thumb" data-index="{{ loop.index0 }}">
                  <img src="{{ image_url(image.image.medium, w=240, q=85, f='auto') }}" data-index="{{ loop.index0 }}" alt="{{ image.alt_text | default(product.name, true) }}">
                </button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="box-1-1 product-images-empty{% if product.selected_product.images | length > 0 %} d-none{% endif %}">
        <div class="content">
          <div class="d-flex bnfsj-product-gallery-empty">
            <img src="{{ 'product-img.svg' | asset_url }}" width="100%" height="auto" alt="{{ product.name }}">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
