<section section-id="{{ sectionId }}" class="bnfsj-section bnfsj-countdown" data-bnfsj-countdown data-date="{{ settings.date }}"{% if settings.background_color or settings.color %} style="{% if settings.background_color %}--section-background: {{ settings.background_color }};{% endif %}{% if settings.color %}--section-color: {{ settings.color }};{% endif %}"{% endif %}>
  <div class="section-slider-padding-space">
    <div class="sale-container bnfsj-container bnfsj-countdown-content" data-countdown-content>
      <h2>{{ settings.title }}</h2>
      <p>{{ settings.description }}</p>
      <div class="bnfsj-countdown-parts" aria-label="{{ _('Countdown') }}">
        <div><span data-countdown-part="days">00</span>{{ _('days') }}</div>
        <div><span data-countdown-part="hours">00</span>{{ _('hours') }}</div>
        <div><span data-countdown-part="minutes">00</span>{{ _('minutes') }}</div>
        <div><span data-countdown-part="seconds">00</span>{{ _('seconds') }}</div>
      </div>
    </div>
    <p class="bnfsj-countdown-ended bnfsj-container" data-countdown-ended hidden>{{ settings.sales_end_description }}</p>
  </div>
</section>
